# Copy this file to .env and fill in the values. .env is git-ignored; never commit real keys.

# Supabase database (Project Settings -> API in the Supabase dashboard).
# The anon key is public and read-only (row-level security). Do NOT put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# AI worker URL (optional). Leave empty to turn off AI answers and semantic search.
EXPO_PUBLIC_AI_URL=

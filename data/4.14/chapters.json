[
 {
  "chapter_no": 1,
  "title_ml": "തൗബചെയ്യാനുള്ള കൽപനയും അക്രമത്തെ നിഷിദ്ധമാക്കലും",
  "title_ar": "بَابٌ: فِي تَحْرِيمِ الظُّلْمِ وَالْأَمْرِ بِالتَّوْبَةِ",
  "start_page": 851,
  "toc_title_ml": null
 },
 {
  "chapter_no": 2,
  "title_ml": "അക്രമിക്ക് സാവകാശം നൽകൽ",
  "title_ar": "بَابٌ: فِي الْإِمْلَاءِ لِلظَّالِمِ",
  "start_page": 852,
  "toc_title_ml": null
 },
 {
  "chapter_no": 3,
  "title_ml": "ജനങ്ങളെ ശിക്ഷിക്കുന്ന വിഭാഗം",
  "title_ar": "بَابٌ: فِي الَّذِينَ يُعَذِّبُونَ النَّاسَ",
  "start_page": 852,
  "toc_title_ml": null
 },
 {
  "chapter_no": 4,
  "title_ml": "അക്രമികളുടെ വാസസ്ഥലത്തേക്ക് കരഞ്ഞുകൊണ്ടല്ലാതെ പ്രവേശിക്കരുത്",
  "title_ar": "بَابٌ: لَا تَدْخُلُوا مَسَاكِنَ الَّذِينَ ظَلَمُوا أَنْفُسَهُمْ إِلَّا أَنْ تَكُونُوا بَاكِينَ",
  "start_page": 853,
  "toc_title_ml": null
 },
 {
  "chapter_no": 5,
  "title_ml": "ശിക്ഷിക്കപ്പെട്ടവരുടെ കിണറുകളിൽനിന്ന് വെള്ളമെടുക്കൽ",
  "title_ar": "بَابٌ: فِي الْإِسْتِسْقَاءِ مِنْ آبَارِ الْمُعَذَّبِينَ",
  "start_page": 853,
  "toc_title_ml": null
 },
 {
  "chapter_no": 6,
  "title_ml": "അന്ത്യനാളിൽ പ്രതികാരമെടുക്കലും അവകാശങ്ങൾ കൊടുത്തുവീട്ടലും",
  "title_ar": "بَابٌ: الْقِصَاصُ وَأَدَاءُ الْحُقُوقِ يَوْمَ الْقِيَامَةِ",
  "start_page": 853,
  "toc_title_ml": null
 },
 {
  "chapter_no": 7,
  "title_ml": "അക്രമിയായാലും അക്രമിക്കപ്പെടുന്നവനായാലും സ്വന്തം സഹോദരനെ സഹായിക്കണം",
  "title_ar": "بَابٌ: لِيَنْصُرِ الرَّجُلُ أَخَاهُ ظَالِمًا أَوْ مَظْلُومًا",
  "start_page": 855,
  "toc_title_ml": null
 },
 {
  "chapter_no": 8,
  "title_ml": "ഒരു മുസ്‌ലിം മറ്റൊരു മുസ്‌ലിമിനെ അക്രമിക്കുകയോ ശത്രുക്കൾക്ക് കൈമാറുകയോ ചെയ്യരുത്",
  "title_ar": "بَابٌ: لَا يَظْلِمُ الْمُسْلِمُ الْمُسْلِمَ وَلَا يُسْلِمُهُ",
  "start_page": 855,
  "toc_title_ml": null
 },
 {
  "chapter_no": 9,
  "title_ml": "അക്രമം അന്ത്യനാളിൽ ഇരുട്ടുകളായിരിക്കും",
  "title_ar": "بَابٌ: الظُّلْمُ ظُلُمَاتٌ يَوْمَ الْقِيَامَةِ",
  "start_page": 856,
  "toc_title_ml": null
 },
 {
  "chapter_no": 10,
  "title_ml": "ഭൂമി അപഹരിച്ചവന്റെ ശിക്ഷ",
  "title_ar": "بَابٌ: إِثْمُ مَنْ ظَلَمَ شَيْئًا مِنَ الْأَرْضِ",
  "start_page": 856,
  "toc_title_ml": null
 },
 {
  "chapter_no": 11,
  "title_ml": "'അവൻ ശക്തമായി തർക്കത്തിലേർപ്പെടുന്നവനാണ്' എന്ന സൂക്തം",
  "title_ar": "بَابٌ: قَوْلُ اللهِ تَعَالَى: {وَهُوَ أَلَدُّ الْخِصَامِ}",
  "start_page": 856,
  "toc_title_ml": null
 },
 {
  "chapter_no": 12,
  "title_ml": "അക്രമിയുടെ സമ്പത്ത് ലഭിച്ചാൽ അക്രമിക്കപ്പെട്ടവൻ പ്രതികാരമെടുക്കൽ",
  "title_ar": "بَابٌ: قِصَاصُ الْمَظْلُومِ إِذَا وُجِدَ مَالُ ظَالِمِهِ",
  "start_page": 857,
  "toc_title_ml": null
 },
 {
  "chapter_no": 13,
  "title_ml": "അയൽവാസി തന്റെ ചുമരിൽ ഒരു മരക്കഷ്ണം നാട്ടുന്നത് ആരും തടയരുത്",
  "title_ar": "بَابٌ: لَا يَمْنَعُ جَارٌ جَارَهُ أَنْ يَغْرِزَ خَشَبَةً فِي جِدَارِهِ",
  "start_page": 857,
  "toc_title_ml": null
 },
 {
  "chapter_no": 14,
  "title_ml": "വഴിയിൽ ഇരിക്കൽ",
  "title_ar": "بَابٌ: الْجُلُوسُ فِي الطُّرُقَاتِ",
  "start_page": 857,
  "toc_title_ml": null
 },
 {
  "chapter_no": 15,
  "title_ml": "വഴിയുടെ കാര്യത്തിൽ തർക്കമുണ്ടായാൽ",
  "title_ar": "بَابٌ: إِذَا اخْتَلَفُوا فِي الطَّرِيقِ",
  "start_page": 858,
  "toc_title_ml": null
 },
 {
  "chapter_no": 16,
  "title_ml": "കവർച്ചയും അംഗവിഛേദവും",
  "title_ar": "بَابٌ: النَّهْيُ عَنِ النُّهْبَى وَالْمُثْلَةِ",
  "start_page": 858,
  "toc_title_ml": null
 },
 {
  "chapter_no": 17,
  "title_ml": "മുതൽ സംരക്ഷിക്കുമ്പോൾ വധിക്കപ്പെടുന്നവൻ",
  "title_ar": "بَابٌ: مَنْ قَاتَلَ دُونَ مَالِهِ",
  "start_page": 858,
  "toc_title_ml": null
 },
 {
  "chapter_no": 18,
  "title_ml": "ഒരുത്തന്റെ പാത്രമോ മറ്റോ പൊട്ടിച്ചാൽ",
  "title_ar": "بَابٌ: إِذَا كَسَرَ قَصْعَةً أَوْ شَيْئًا لِغَيْرِهِ",
  "start_page": 858,
  "toc_title_ml": null
 }
]
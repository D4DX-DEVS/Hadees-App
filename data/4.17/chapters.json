[
 {
  "chapter_no": 1,
  "title_ml": "ഉള്ഹിയത്തിന്റെ ശ്രേഷ്ഠത",
  "title_ar": "بَابٌ: مَا جَاءَ فِي فَضْلِ الْأُضْحِيَّةِ",
  "start_page": 889,
  "toc_title_ml": null
 },
 {
  "chapter_no": 2,
  "title_ml": "ഉള്ഹിയത്ത് നിർബന്ധമാണോ?",
  "title_ar": "بَابٌ: الْأَضَاحِي وَاجِبَةٌ هِيَ أَمْ لَا؟",
  "start_page": 889,
  "toc_title_ml": null
 },
 {
  "chapter_no": 3,
  "title_ml": "ഉള്ഹിയത്ത് അറുക്കുന്ന യാത്രക്കാരൻ",
  "title_ar": "بَابٌ: فِي الْمُسَافِرِ يُضَحِّي",
  "start_page": 890,
  "toc_title_ml": null
 },
 {
  "chapter_no": 4,
  "title_ml": "മരിച്ചവർക്കുവേണ്ടി ഉള്ഹിയത്ത് അറുകൽ",
  "title_ar": "بَابٌ: مَا جَاءَ فِي الْأُضْحِيَّةِ عَنِ الْمَيِّتِ",
  "start_page": 890,
  "toc_title_ml": null
 },
 {
  "chapter_no": 5,
  "title_ml": "ഉള്ഹിയത്ത് അറുക്കുന്നവൻ ദുൽഹിജ്ജ പത്തുവരെ ചെയ്യേണ്ടത്",
  "title_ar": "بَابٌ: مَا يَفْعَلُهُ الْمُضَحِّي فِي عَشْرِ ذِي الْحِجَّةِ",
  "start_page": 891,
  "toc_title_ml": null
 },
 {
  "chapter_no": 6,
  "title_ml": "ഉള്ഹിയത്തിനുള്ള മൃഗത്തെ ലഭിക്കാത്തവൻ",
  "title_ar": "بَابٌ: مَنْ لَمْ يَجِدِ الْأُضْحِيَّةَ",
  "start_page": 891,
  "toc_title_ml": null
 },
 {
  "chapter_no": 7,
  "title_ml": "റസൂൽ(സ) ഉള്ഹിയത്ത് അറുത്തത്",
  "title_ar": "بَابٌ: أَضَاحِي رَسُولِ اللهِ (صلعم)",
  "start_page": 892,
  "toc_title_ml": null
 },
 {
  "chapter_no": 8,
  "title_ml": "സ്വന്തം കൈകൊണ്ട് ഉള്ഹിയത്ത് അറുക്കുന്നവൻ",
  "title_ar": "بَابٌ: مَنْ ذَبَحَ أُضْحِيَّةً بِيَدِهِ",
  "start_page": 894,
  "toc_title_ml": null
 },
 {
  "chapter_no": 9,
  "title_ml": "ഉള്ഹിയത്ത് അറുക്കുമ്പോൾ ബിസ്മി ചൊല്ലൽ",
  "title_ar": "بَابٌ: تَسْمِيَةُ اللهِ عَزَّ وَجَلَّ عَلَى الضَّحِيَّةِ",
  "start_page": 894,
  "toc_title_ml": null
 },
 {
  "chapter_no": 10,
  "title_ml": "തന്റേതല്ലാത്ത ഉള്ഹിയത്ത് അറുകൽ",
  "title_ar": "بَابٌ: ذَبْحُ الرَّجُلِ غَيْرَ أُضْحِيَّتِهِ",
  "start_page": 894,
  "toc_title_ml": null
 },
 {
  "chapter_no": 11,
  "title_ml": "ഉള്ഹിയത്ത് അറുക്കാൻ പറ്റുന്ന മൃഗങ്ങൾ",
  "title_ar": "بَابٌ: مَا تُجْزِئُ مِنَ الْأَضَاحِي",
  "start_page": 894,
  "toc_title_ml": null
 },
 {
  "chapter_no": 12,
  "title_ml": "ആട്",
  "title_ar": "بَابٌ: الْكَبْشُ",
  "start_page": 896,
  "toc_title_ml": null
 },
 {
  "chapter_no": 13,
  "title_ml": "ഉള്ഹിയത്ത് അറുക്കുന്നതിന് യോജിക്കാത്ത മൃഗങ്ങൾ",
  "title_ar": "بَابٌ: مَا يُكْرَهُ أَنْ يُضَحَّى بِهِ",
  "start_page": 896,
  "toc_title_ml": null
 },
 {
  "chapter_no": 14,
  "title_ml": "നല്ല ബലിമൃഗത്തെ വാങ്ങിയശേഷം അതിന് വല്ലതും സംഭവിച്ചാൽ",
  "title_ar": "بَابٌ: مَنِ اشْتَرَى أُضْحِيَّةً صَحِيحَةً فَأَصَابَهَا عِنْدَهُ شَيْءٌ",
  "start_page": 898,
  "toc_title_ml": null
 },
 {
  "chapter_no": 15,
  "title_ml": "ഉള്ഹിയത്തിൽ പങ്കുചേരൽ",
  "title_ar": "بَابٌ: مَا جَاءَ فِي الْإِشْتِرَاكِ فِي الْأُضْحِيَّةِ",
  "start_page": 898,
  "toc_title_ml": null
 },
 {
  "chapter_no": 16,
  "title_ml": "ഒട്ടകത്തിനു പകരം എത്ര ആടുകളെ അറുക്കണം?",
  "title_ar": "بَابٌ: كَمْ تُجْزِئُ مِنَ الْغَنَمِ عَنِ الْبَدَنَةِ",
  "start_page": 899,
  "toc_title_ml": null
 },
 {
  "chapter_no": 17,
  "title_ml": "തന്റെ കുടുംബത്തിനുവേണ്ടി ഒരു ആടിനെ ഉള്ഹിയത്ത് അറുക്കൽ",
  "title_ar": "بَابٌ: مَنْ ضَحَّى بِشَاةٍ عَنْ أَهْلِهِ",
  "start_page": 901,
  "toc_title_ml": null
 },
 {
  "chapter_no": 18,
  "title_ml": "ബലിമൃഗങ്ങളുടെ തോൽ",
  "title_ar": "بَابٌ: جُلُودُ الْأَضَاحِي",
  "start_page": 905,
  "toc_title_ml": null
 },
 {
  "chapter_no": 19,
  "title_ml": "ഉള്ഹിയത്തിന്റെ മാംസം ഭക്ഷിക്കൽ",
  "title_ar": "بَابٌ: الْأَكْلُ مِنْ لُحُومِ الضَّحَايَا",
  "start_page": 905,
  "toc_title_ml": null
 },
 {
  "chapter_no": 20,
  "title_ml": "ഉള്ഹിയത്ത് അറുക്കേണ്ടെ സമയം",
  "title_ar": "بَابٌ: الْوَقْتُ الَّذِي يُذْبَحُ فِيهِ الْأُضْحِيَّةُ",
  "start_page": 905,
  "toc_title_ml": null
 },
 {
  "chapter_no": 21,
  "title_ml": "നമസ്കാര സ്ഥലത്തുവെച്ച് അറുക്കൽ",
  "title_ar": "بَابٌ: الذَّبْحُ بِالْمُصَلَّى",
  "start_page": 909,
  "toc_title_ml": null
 },
 {
  "chapter_no": 22,
  "title_ml": "അഖീഖത്ത്",
  "title_ar": "كِتَابُ الْعَقِيقَة",
  "start_page": 909,
  "toc_title_ml": null
 },
 {
  "chapter_no": 23,
  "title_ml": "കുട്ടിക്ക് പേരിടൽ",
  "title_ar": "بَابٌ: تَسْمِيَةُ الْمَوْلُودِ",
  "start_page": 911,
  "toc_title_ml": null
 },
 {
  "chapter_no": 24,
  "title_ml": "കുട്ടിയുടെ ചെവിയിൽ ബാങ്ക് കൊടുക്കൽ",
  "title_ar": "بَابٌ: الْأَذَانُ فِي أُذُنِ الْمَوْلُودِ",
  "start_page": 912,
  "toc_title_ml": null
 },
 {
  "chapter_no": 25,
  "title_ml": "മൃഗത്തിന്റെ കടിഞ്ഞൂലിനെ അറുക്കലും റജബ് മാസത്തിലെ അറവും",
  "title_ar": "كِتَابُ الْفَرَعِ وَالْعَتِيرَةِ",
  "start_page": 912,
  "toc_title_ml": null
 }
]
[
 {
  "chapter_no": 1,
  "title_ml": "ആദം(അ)മിന്റെ സൃഷ്ടിപ്പിന്റെ തുടക്കം",
  "title_ar": "بَابٌ: في ابْتِدَاءِ خَلْقِ آدَمَ عَلَيْهِ السَّلَامُ",
  "start_page": 259,
  "toc_title_ml": null
 },
 {
  "chapter_no": 2,
  "title_ml": "ആദം(അ)മിന്റെയും സന്തതികളുടെയും സൃഷ്ടിപ്പ്",
  "title_ar": "بَابٌ: خَلْقُ آدَمَ عَلَيْهِ السَّلَامُ وَذُرِّيَّتِه",
  "start_page": 259,
  "toc_title_ml": null
 },
 {
  "chapter_no": 3,
  "title_ml": "മൂന്നു കാര്യങ്ങൾ ഒരു പ്രവാചകനു മാത്രമേ അറിയൂ",
  "title_ar": "بَابٌ: ثَلَاثٌ لَا يَعْلَمُهُنَّ إِلَّا نَبِيٌّ",
  "start_page": 261,
  "toc_title_ml": null
 },
 {
  "chapter_no": 4,
  "title_ml": "അല്ലാഹു ഒരു സമൂഹത്തോട് കരുണ ചെയ്താൽ പ്രവാചകനെ ആദ്യം മരിപ്പിക്കും",
  "title_ar": "بَابٌ: إِذَا رَحِمَ اللهُ أُمَّةً قَبَضَ نَبِيَّهَا قَبْلَهَا",
  "start_page": 262,
  "toc_title_ml": null
 },
 {
  "chapter_no": 5,
  "title_ml": "പ്രവാചകന്മാരെല്ലാം ആടിനെ മേച്ചിട്ടുണ്ട്",
  "title_ar": "بَابٌ: مَا مِنْ نَبِيٍّ إِلَّا وَقَدْ رَعَى الْغَنَمَ",
  "start_page": 262,
  "toc_title_ml": null
 },
 {
  "chapter_no": 6,
  "title_ml": "പ്രവാചകന്മാർക്കിടയിൽ ശ്രേഷ്ഠത കൽപിക്കരുത്",
  "title_ar": "بَابٌ: قَوْلُ النَّبِيِّ (صلعم): لَا تُفَضِّلُوا بَيْنَ أَنْبِيَاءِ اللهِ",
  "start_page": 262,
  "toc_title_ml": null
 },
 {
  "chapter_no": 7,
  "title_ml": "ദുൽഖർനൈനിയെക്കുറിച്ച് അവർ ചോദിക്കുന്നു എന്ന സൂക്തം",
  "title_ar": "بَابٌ: قَوْلُهُ تَعَالَى {وَيَسْأَلُونَكَ عَنْ ذِي الْقَرْنَيْنِ ...} الخ",
  "start_page": 263,
  "toc_title_ml": null
 },
 {

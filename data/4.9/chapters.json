 {
  "chapter_no": 1,
  "title_ml": "മക്കയുടെ മഹത്വം",
  "title_ar": "بَابٌ: فِي فَضْلِ مَكَّةَ",
  "start_page": 515,
  "toc_title_ml": null
 },
 {
  "chapter_no": 2,
  "title_ml": "മക്കയിൽവെച്ച് റമളാൻ ലഭിച്ചവൻ",
  "title_ar": "بَابٌ: مَنْ أَدْرَكَ رَمَضَانَ فِي مَكَّةَ",
  "start_page": 516,
  "toc_title_ml": null
 },
 {
  "chapter_no": 3,
  "title_ml": "ഖബ്റുകൾ സന്ദർശിക്കൽ",
  "title_ar": "بَابٌ: فِي زِيَارَةِ الْقُبُورِ",
  "start_page": 516,
  "toc_title_ml": null
 },
 {
  "chapter_no": 4,
  "title_ml": "മദീനയുടെ മഹത്വം",
  "title_ar": "بَابٌ: مَا جَاءَ فِي فَضْلِ الْمَدِينَةِ",
  "start_page": 517,
  "toc_title_ml": null
 },
 {
  "chapter_no": 5,
  "title_ml": "എന്റെ ഖബ്റിനും മിമ്പറിനും ഇടയിലുള്ള സ്ഥലം",
  "title_ar": "بَابٌ: مَا بَيْنَ بَيْتِي وَمِنْبَرِي",
  "start_page": 524,
  "toc_title_ml": null
 },
 {
  "chapter_no": 6,
  "title_ml": "മദീന 'ത്വാബ'യാണ്",
  "title_ar": "بَابٌ: الْمَدِينَةُ الطَّابَةُ",
  "start_page": 524,
  "toc_title_ml": null
 },
 {
  "chapter_no": 7,
  "title_ml": "ഈമാൻ മദീനയിലേക്ക് മടങ്ങും",
  "title_ar": "بَابٌ: الْإِيمَانُ يَأْرِزُ إِلَى الْمَدِينَةِ",
  "start_page": 525,
  "toc_title_ml": null
 },
 {
  "chapter_no": 8,
  "title_ml": "മദീനയിൽ താമസിക്കാനുള്ള പ്രേരണ",
  "title_ar": "بَابٌ: التَّرْغِيبُ فِي سُكْنَى الْمَدِينَةِ",
  "start_page": 525,
  "toc_title_ml": null
 },
 {
  "chapter_no": 9,
  "title_ml": "മദീന മ്ലേഛമായതിനെ പുറംതള്ളും",
  "title_ar": "بَابٌ: الْمَدِينَةُ تَنْفِي الْخَبَثَ",
  "start_page": 526,
  "toc_title_ml": null
 },
 {
  "chapter_no": 10,
  "title_ml": "മദീനയിലെ കുന്നുകൾ",
  "title_ar": "بَابٌ: آطَامُ الْمَدِينَةِ",
  "start_page": 527,
  "toc_title_ml": null
 },
 {
  "chapter_no": 11,
  "title_ml": "പ്ലേഗും ദജ്ജാലും മദീനയിൽ പ്രവേശിക്കുകയില്ല",
  "title_ar": "بَابٌ: لَا يَدْخُلُ الطَّاعُونُ وَالدَّجَّالُ الْمَدِينَةَ",
  "start_page": 527,
  "toc_title_ml": null
 },
 {
  "chapter_no": 12,
  "title_ml": "ഇരു ഹറമുകളിൽ നമസ്കരിക്കുന്നതിന്റെ പുണ്യം",
  "title_ar": "بَابٌ: فَضْلُ الصَّلَاةِ بِمَسْجِدَيِ الْحَرَمَيْنِ الشَّرِيفَيْنِ",
  "start_page": 529,
  "toc_title_ml": null
 },
 {
  "chapter_no": 13,
  "title_ml": "മസ്ജിദുൽഖുബായിലുള്ള നമസ്കാരം",
  "title_ar": "بَابٌ: الصَّلَاةُ فِي مَسْجِدِ الْقُبَاءِ",
  "start_page": 529,
  "toc_title_ml": null
 },
 {
  "chapter_no": 14,
  "title_ml": "മദീനയിലേക്കുള്ള യാത്ര",
  "title_ar": "بَابٌ: فِي إِتْيَانِ الْمَدِينَةِ",
  "start_page": 530,
  "toc_title_ml": null
 }
]
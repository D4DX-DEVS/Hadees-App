[
 {
  "chapter_no": 1,
  "title_ml": "ജനങ്ങളെ പിഴപ്പിക്കാൻ പിശാചിന്റെ സൈനിക സന്നാഹം",
  "title_ar": "بَابٌ: بَعْثُ الشَّيْطَان سَرَايَاهُ يَفْتِنُونَ النَّاسَ",
  "start_page": 955,
  "toc_title_ml": null
 },
 {
  "chapter_no": 2,
  "title_ml": "ഫിത്നയും അതിന്റെ അടയാളങ്ങളും",
  "title_ar": "بَابٌ: ذِكْرُ الْفِتَنِ وَدَلَائِلُهَا",
  "start_page": 956,
  "toc_title_ml": null
 },
 {
  "chapter_no": 3,
  "title_ml": "ഫിത്നകൾ വെളിവാകൽ",
  "title_ar": "بَابٌ: ظُهُورُ الْفِتَنِ",
  "start_page": 959,
  "toc_title_ml": null
 },
 {
  "chapter_no": 4,
  "title_ml": "മഴത്തുള്ളികൾ പോലെ ഫിത്നകൾ സംഭവിക്കൽ",
  "title_ar": "بَابٌ: فِي نُزُولِ الْفِتَنِ كَمَوَاقِعِ الْقَطْرِ",
  "start_page": 960,
  "toc_title_ml": null
 },
 {
  "chapter_no": 5,
  "title_ml": "ലഹള",
  "title_ar": "بَابٌ: الْهَرْجُ",
  "start_page": 961,
  "toc_title_ml": null
 },
 {
  "chapter_no": 6,
  "title_ml": "ഫിത്നയുടെ സമയത്ത് മരത്തിന്റെ വാൾ ഉണ്ടാക്കൽ",
  "title_ar": "بَابٌ: مَا جَاءَ فِي اتِّخَاذ سَيْفٍ مِنْ خَشَبٍ فِي الْفِتْنَة",
  "start_page": 962,
  "toc_title_ml": null
 },
 {
  "chapter_no": 7,
  "title_ml": "കിഴക്കിലെ ഫിത്ന",
  "title_ar": "بَابٌ: الْفِتْنَةُ نَحْوَ الْمَشْرِقِ",
  "start_page": 962,
  "toc_title_ml": null
 },
 {
  "chapter_no": 8,
  "title_ml": "കുഴപ്പങ്ങൾ",
  "title_ar": "بَابٌ: مَا يَكُونُ مِنَ الْفِتَنِ",
  "start_page": 963,
  "toc_title_ml": null
 },
 {
  "chapter_no": 9,
  "title_ml": "കുഴപ്പങ്ങൾ ഹൃദയങ്ങളെ ബാധിക്കൽ",
  "title_ar": "بَابٌ: عَرْضُ الْفِتَنِ عَلَى الْقُلُوبِ وَنَكْتُهَا فِيهَا",
  "start_page": 964,
  "toc_title_ml": null
 },
 {
  "chapter_no": 10,
  "title_ml": "നിലക്കാത്ത ഫിത്നകൾ",
  "title_ar": "بَابٌ: تَوَالِي الْفِتَنِ",
  "start_page": 965,
  "toc_title_ml": null
 },
 {
  "chapter_no": 11,
  "title_ml": "മുതലിന്റെ ഫിത്ന",
  "title_ar": "بَابٌ: فِتْنَةُ الْمَال",
  "start_page": 966,
  "toc_title_ml": null
 },
 {
  "chapter_no": 12,
  "title_ml": "സ്ത്രീകളുടെ ഫിത്ന",
  "title_ar": "بَابٌ: فِتْنَةُ النِّسَاء",
  "start_page": 968,
  "toc_title_ml": null
 },
 {
  "chapter_no": 13,
  "title_ml": "നിങ്ങൾ മുൻഗാമികളുടെ ചര്യ പിന്തുടരുക തന്നെചെയ്യും",
  "title_ar": "بَابٌ: لَتَتَّبِعُنَّ سُنَنَ الَّذِينَ مِنْ قَبْلِكُمْ",
  "start_page": 971,
  "toc_title_ml": null
 },
 {
  "chapter_no": 14,
  "title_ml": "എന്റെ സമുദായത്തെ നശിപ്പിക്കുന്നത് ഖുറൈശികളായിരിക്കും",
  "title_ar": "بَابٌ: يُهْلِكُ أُمَّتِي قُرَيْشٌ",
  "start_page": 972,
  "toc_title_ml": null
 },
 {
  "chapter_no": 15,
  "title_ml": "ഫിത്നയും അതിനെ കുറിച്ച് അറിയുന്നവരും",
  "title_ar": "بَابٌ: فِي الْفِتَنِ وَمَنْ كَانَ يَحْفَظُهَا",
  "start_page": 973,
  "toc_title_ml": null
 },
 {
  "chapter_no": 16,
  "title_ml": "ഫിത്നയുടെ സമയത്ത് ഉറച്ചുനിൽക്കൽ",
  "title_ar": "بَابٌ: التَّثَبُّتُ فِي الْفِتْنَة",
  "start_page": 973,
  "toc_title_ml": null
 },
 {
  "chapter_no": 17,
  "title_ml": "ഫിത്നയിൽ പ്രവേശിക്കുന്നതിനുള്ള നിരോധനം",
  "title_ar": "بَابٌ: فِي النَّهْيِ عَنِ السَّعْيِ فِي الْفِتْنَة",
  "start_page": 975,
  "toc_title_ml": null
 },
 {
  "chapter_no": 18,
  "title_ml": "മുസ്ലിംകളെയോ മുഅ്മിനുകളെയോ വധിക്കൽ",
  "title_ar": "بَابٌ: قَتْلُ الْمُسْلِمِينَ أَوِ الْمُؤْمِنِينَ",
  "start_page": 977,
  "toc_title_ml": null
 },
 {
  "chapter_no": 19,
  "title_ml": "വിശ്വാസിയെ വധിക്കുന്നതിന്റെ ഗൗരവം",
  "title_ar": "بَابٌ: فِي تَعْظِيمِ قَتْلِ الْمُؤْمِن",
  "start_page": 980,
  "toc_title_ml": null
 },
 {
  "chapter_no": 20,
  "title_ml": "രണ്ട് മുസ്ലിംകൾ പരസ്പരം ഏറ്റുമുട്ടിയാൽ കൊന്നവനും കൊല്ലപ്പെട്ടവനും നരകത്തിലാണ്",
  "title_ar": "بَابٌ: إِذَا تَوَاجَهَ الْمُسْلمَان بِسَيْفَيْهِمَا فَالْقَاتلُ وَالْمَقْتُولُ فِي النَّارِ",
  "start_page": 983,
  "toc_title_ml": null
 },
 {
  "chapter_no": 21,
  "title_ml": "മുസ്ലിംകൾ അല്ലാഹുവിന്റെ ഉത്തരവാദിത്തത്തിലാണ്",
  "title_ar": "بَابٌ: الْمُسْلِمُونَ فِي ذِمَّة اللهِ عَزَّ وَجَلَّ",
  "start_page": 985,
  "toc_title_ml": null
 },
 {
  "chapter_no": 22,
  "title_ml": "കൊള്ള നിരോധിതം",
  "title_ar": "بَابٌ: النَّهْيُ عَنِ النُّهْبَة",
  "start_page": 985,
  "toc_title_ml": null
 },
 {
  "chapter_no": 23,
  "title_ml": "കുഴപ്പങ്ങളുണ്ടാകുമ്പോൾ ചെയ്യേണ്ടത്",
  "title_ar": "بَابٌ: مَا يَفْعَلُ الرَّجُلُ عِنْدَ الْفِتْنَة",
  "start_page": 986,
  "toc_title_ml": null
 },
 {
  "chapter_no": 24,
  "title_ml": "കുഴപ്പമുണ്ടാകുന്ന സമയത്ത് കർമ്മങ്ങൾക്കുള്ള ശ്രേഷ്ഠത",
  "title_ar": "بَابٌ: فَضْلُ الْعَمَلِ عِنْدَ الْفِتْنَة",
  "start_page": 989,
  "toc_title_ml": null
 },
 {
  "chapter_no": 25,
  "title_ml": "'സത്യവിശ്വാസികളേ, നിങ്ങൾ സ്വന്തത്തെ സൂക്ഷിക്കുക' എന്ന സൂക്തം",
  "title_ar": "بَابٌ: قَوْلُهُ تَعَالَى: {يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ}",
  "start_page": 991,
  "toc_title_ml": null
 },
 {
  "chapter_no": 26,
  "title_ml": "കുഴപ്പങ്ങളിൽ നിന്ന് രക്ഷ പ്രതീക്ഷിക്കപ്പെടുന്നവർ",
  "title_ar": "بَابٌ: مَنْ تُرْجَى لَهُ السَّلَامَةُ مِنَ الْفِتَنِ",
  "start_page": 991,
  "toc_title_ml": null
 },
 {
  "chapter_no": 27,
  "title_ml": "അവ്യക്തതകളോടുള്ള സമീപനം",
  "title_ar": "بَابٌ: الْوُقُوفُ عِنْدَ الشُّبُهَاتِ",
  "start_page": 992,
  "toc_title_ml": null
 },
 {
  "chapter_no": 28,
  "title_ml": "ഏകാന്തവാസം",
  "title_ar": "بَابٌ: الْعَزْلَةُ",
  "start_page": 993,
  "toc_title_ml": null
 },
 {
  "chapter_no": 29,
  "title_ml": "കുഴപ്പമുണ്ടാകുമ്പോഴുള്ള വിഷമങ്ങൾ ക്ഷമിക്കൽ",
  "title_ar": "بَابٌ: الصَّبْرُ عَلَى الْبَلَاءِ عِنْدَ الْفِتْنَةِ",
  "start_page": 994,
  "toc_title_ml": null
 },
 {
  "chapter_no": 30,
  "title_ml": "കഷ്ട കാലങ്ങൾ",
  "title_ar": "بَابٌ: شِدَّةُ الزَّمَان",
  "start_page": 998,
  "toc_title_ml": null
 },
 {
  "chapter_no": 31,
  "title_ml": "നന്മ കൽപിക്കലും തിന്മ നിരോധിക്കലും",
  "title_ar": "بَابٌ: الْأَمْرُ بِالْمَعْرُوف وَالنَّهْيُ عَنِ الْمُنْكَر",
  "start_page": 999,
  "toc_title_ml": null
 },
 {
  "chapter_no": 32,
  "title_ml": "ദുർഭരണാധികാരികളെ സംബന്ധിച്ച് മുന്നറിയിപ്പ്",
  "title_ar": "بَابٌ: التَّحْذِيرُ مِنْ أُمَرَاء السُّوء",
  "start_page": 1005,
  "toc_title_ml": null
 },
 {
  "chapter_no": 33,
  "title_ml": "പുത്തനാശയത്തെയും ദുഃസ്വഭാവത്തെയും സംബന്ധിച്ച് മുന്നറിയിപ്പ്",
  "title_ar": "بَابٌ: فِي التَّحْذِيرِ مِنَ الْبِدَعِ وَمَسَاوِئِ الْأَخْلَاق",
  "start_page": 1006,
  "toc_title_ml": null
 },
 {
  "chapter_no": 34,
  "title_ml": "സ്ത്രീയെ അധികാരമേൽപ്പിക്കുന്നതിലുള്ള മുന്നറിയിപ്പ്",
  "title_ar": "بَابٌ: التَّحْذِيرُ مِنْ تَوْلِيَة الْمَرْأَة",
  "start_page": 1006,
  "toc_title_ml": null
 },
 {
  "chapter_no": 35,
  "title_ml": "ജനവാസമില്ലാത്ത സ്ഥലത്ത് താമസിക്കുന്നതിനുള്ള മുന്നറിയിപ്പ്",
  "title_ar": "بَابٌ: التَّحْذِيرُ مِنْ سُكْنَى الْبَادِيَة",
  "start_page": 1007,
  "toc_title_ml": null
 },
 {
  "chapter_no": 36,
  "title_ml": "റസൂൽ(സ)യെക്കുറിച്ച് കളവ് പറയൽ",
  "title_ar": "بَابٌ: التَّحْذِيرُ مِنَ الْكَذِب عَلَى رَسُول اللهِ صَلَّى اللهُ عَلَيْه وَسَلَّمَ",
  "start_page": 1007,
  "toc_title_ml": null
 },
 {
  "chapter_no": 37,
  "title_ml": "അക്രമിയായ വിധികർത്താവിനെ സഹായിക്കൽ",
  "title_ar": "بَابٌ: التَّحْذِيرُ مِنْ إِعَانَة الْحَاكِم الظَّالِم",
  "start_page": 1007,
  "toc_title_ml": null
 },
 {
  "chapter_no": 38,
  "title_ml": "ശിക്ഷകൾ",
  "title_ar": "بَابٌ: الْعُقُوبَاتُ",
  "start_page": 1008,
  "toc_title_ml": null
 }
]
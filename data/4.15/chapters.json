[
 {
  "chapter_no": 1,
  "title_ml": "ദാനവും അതിന്റെ ശ്രേഷ്ഠതയും",
  "title_ar": "بَابٌ: الْهِبَةُ وَفَضْلُهَا",
  "start_page": 859,
  "toc_title_ml": null
 },
 {
  "chapter_no": 2,
  "title_ml": "മനുഷ്യന് മരണശേഷവും പ്രതിഫലം ലഭിക്കുന്ന കാര്യങ്ങൾ",
  "title_ar": "بَابٌ: مَا يَلْحَقُ الْإِنْسَانَ ثَوَابُهُ بَعْدَهُ",
  "start_page": 865,
  "toc_title_ml": null
 },
 {
  "chapter_no": 3,
  "title_ml": "ആവശ്യം നിറവേറ്റിയതിനുള്ള പാരിതോഷികം",
  "title_ar": "بَابٌ: فِي الْهَدْيَة لقَضَاء الْحَاجَة",
  "start_page": 865,
  "toc_title_ml": null
 },
 {
  "chapter_no": 4,
  "title_ml": "അംശദാനം",
  "title_ar": "بَابٌ: هبَةُ الْمُشَاعِ",
  "start_page": 866,
  "toc_title_ml": null
 },
 {
  "chapter_no": 5,
  "title_ml": "ദാനം നൽകിയത് തിരിച്ചു വാങ്ങൽ",
  "title_ar": "بَابٌ: الرُّجُوعُ فِي الْهِبَة",
  "start_page": 867,
  "toc_title_ml": null
 },
 {
  "chapter_no": 6,
  "title_ml": "തന്റെ മകന് നൽകിയതിനെ പിതാവ് തിരിച്ചു വാങ്ങൽ",
  "title_ar": "بَابٌ: رُجُوعُ الْوَالد فيمَا يُعْطِي وَلَدَهُ",
  "start_page": 868,
  "toc_title_ml": null
 },
 {
  "chapter_no": 7,
  "title_ml": "ദാനം നൽകിയ വസ്തു വിൽക്കപ്പെടുന്നത് കണ്ടാൽ വാങ്ങാമോ?",
  "title_ar": "بَابٌ: مَنْ تَصَدَّقَ بِصَدَقَةٍ فَوَجَدَهَا تُبَاعُ هَلْ يَشْتَرِيهَا",
  "start_page": 869,
  "toc_title_ml": null
 },
 {
  "chapter_no": 8,
  "title_ml": "ദാനം നൽകിയ വസ്തു അനന്തരമായി ലഭിച്ചാൽ",
  "title_ar": "بَابٌ: مَنْ تَصَدَّقَ بِصَدَقَةٍ ثُمَّ وَرِثَهَا",
  "start_page": 869,
  "toc_title_ml": null
 },
 {
  "chapter_no": 9,
  "title_ml": "ഭർത്താവിന്റെ അനുവാദമില്ലാതെ സ്ത്രീ ദാനം ചെയ്യൽ",
  "title_ar": "بَابٌ: عَطِيَّةُ الْمَرْأَةِ بِغَيْرِ إِذْنِ زَوْجِهَا",
  "start_page": 869,
  "toc_title_ml": null
 },
 {
  "chapter_no": 10,
  "title_ml": "പ്രത്യുപകാരമില്ലാതെ മുതൽ ഭാഗിച്ചു നൽകൽ",
  "title_ar": "بَابٌ: النُّحْلُ",
  "start_page": 871,
  "toc_title_ml": null
 },
 {
  "chapter_no": 11,
  "title_ml": "ഉംറാ³ ദാനവും റുഖ്ബാ⁴ ദാനവും",
  "title_ar": "بَابٌ: الْعُمْرَى وَالرُّقْبَى",
  "start_page": 874,
  "toc_title_ml": null
 }
]
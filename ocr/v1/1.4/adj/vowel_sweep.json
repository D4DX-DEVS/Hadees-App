   "idx": 3
  },
  {
   "pdf_page": 2,
   "block": 3,
   "field": "malayalam",
   "word": "വുളു",
   "context": "വുളു വിശ്വാസത്തിന്റെ പകുതിയാണ്",
   "idx": 4
  },
  {
